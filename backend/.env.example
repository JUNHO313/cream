# 백엔드 환경변수 예시
# 이 파일을 복사해 .env 로 만들어 두고, 아래처럼 실행하면 적용됩니다.
#   node --env-file=.env server.js
# 아무 것도 지정하지 않아도 기본값으로 동작합니다.

# 서버 포트 (기본 3000)
PORT=3000

# 데이터 저장 방식: json (기본) / 나중에 mysql 등을 추가
DATA_DRIVER=json

# 프론트엔드를 이 서버가 같이 제공할지 (기본 true)
# 프론트를 따로 배포한다면 false 로 두세요.
SERVE_FRONTEND=true

# API 호출을 허용할 프론트 주소. 쉼표로 여러 개, * 는 전부 허용 (기본 *)
# 예) CORS_ORIGIN=http://localhost:5500,https://내도메인.com
CORS_ORIGIN=*

# ── 관리자 페이지 ──────────────────────────────────────────
# 관리자 비밀번호.
# 지정하면 이 값을 쓰고, 파일에는 아무것도 저장되지 않습니다. (권장)
# 지정하지 않으면 서버가 처음 실행될 때 임의로 만들어 터미널에 한 번만 보여줍니다.
ADMIN_PASSWORD=원하는비밀번호로바꾸세요

# 로그인 유지 시간 (시간 단위, 기본 12)
ADMIN_SESSION_HOURS=12

# HTTPS 에 배포했다면 true 로 켜세요. (로컬 http 에서는 false)
ADMIN_SECURE_COOKIE=false
