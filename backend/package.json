{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "장준호 포트폴리오 백엔드 API 서버 (Express)",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "//": ".env 파일이 있으면 자동으로 읽습니다. 없어도 그냥 실행됩니다.",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  }
}
